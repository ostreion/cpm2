# Local workspace — not versioned
DEV/
evaluation/

# Per-run benchmark outputs (executed notebooks, run.log, queue logs)
benchmarks/runs/

# Benchmark per-job MD outputs (multi-GB across all matches) — track shortlists,
# trajectory_metrics, diagnostics PNGs, scripts, and top-level monitor.log;
# the per-job working dirs themselves are out of scope for git.
benchmarks/**/jobs/
benchmarks/**/niklas_ref/

# Claude Code local scratch (per-session)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Marimo build artifacts in notebooks/
notebooks/__marimo__/

# Built WASM marimo export of triage (source is in notebooks/triage_bundle_src/)
notebooks/triage_bundle/

# Per-cell __marimo__ build cache inside the bundle src
notebooks/triage_bundle_src/__marimo__/

# macOS Finder metadata
.DS_Store

